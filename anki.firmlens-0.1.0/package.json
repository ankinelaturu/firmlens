{
  "name": "firmlens",
  "displayName": "FirmLens",
  "description": "Hover C variables and see captured firmware snapshot values (Intel HEX + ELF/DWARF).",
  "version": "0.1.4",
  "publisher": "anki",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:c",
    "onLanguage:cpp",
    "onCustomEditor:firmlens.hexViewer"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "firmlens.loadSnapshot",
        "title": "FirmLens: Load Snapshot"
      },
      {
        "command": "firmlens.clearSnapshot",
        "title": "FirmLens: Clear Snapshot"
      },
      {
        "command": "firmlens.viewSnapshot",
        "title": "FirmLens: View Snapshot",
        "icon": "$(open-preview)"
      },
      {
        "command": "firmlens.openHexViewer",
        "title": "FirmLens: Open Hex File in Viewer",
        "icon": "$(file-binary)"
      }
    ],
    "customEditors": [
      {
        "viewType": "firmlens.hexViewer",
        "displayName": "FirmLens Hex Snapshot",
        "selector": [
          {
            "filenamePattern": "*.{hex,HEX}"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "FirmLens",
      "properties": {
        "firmlens.sourceRootRemap": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          },
          "description": "Map build-machine path prefixes to local workspace folders."
        },
        "firmlens.maxStructFields": {
          "type": "number",
          "default": 32,
          "minimum": 1,
          "description": "Maximum struct fields shown in a hover preview."
        },
        "firmlens.maxReadBytes": {
          "type": "number",
          "default": 256,
          "minimum": 1,
          "description": "Maximum bytes read for one hover."
        },
        "firmlens.autoLoadOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "When true, load a snapshot bundle after startup (deploy/ or firmlens.autoLoadPaths)."
        },
        "firmlens.deployDirectory": {
          "type": "string",
          "default": "deploy",
          "description": "Folder at workspace root containing snapshot.hex, firmware.axf, and optional firmware.map / metadata.json. Falls back to build/."
        },
        "firmlens.autoLoadPaths": {
          "type": "object",
          "default": {},
          "description": "Optional override for HEX/AXF/map/metadata. When empty, FirmLens uses deployDirectory (then build/).",
          "properties": {
            "hex": { "type": "string" },
            "axf": { "type": "string" },
            "map": { "type": "string" },
            "metadata": { "type": "string" }
          }
        }
      }
    }
  }
}